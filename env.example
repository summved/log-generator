# Environment variables
#
# The tool reads these from the environment; it does not load a .env file itself.
# `docker compose` reads a .env file next to the compose file automatically, so copy
# this file to .env when using docker-compose.yml or docker-compose.production.yml.

# ---- Read by the log generator ------------------------------------------------
# Port for the monitoring endpoints (/health, /ready, /metrics, /status)
HTTP_PORT=3000
# Set to false to disable the monitoring HTTP server
ENABLE_MONITORING=true
# Config file used by `node dist/index.js` (default: src/config/default.yaml)
# CONFIG_PATH=./config/my-config.yaml

# ---- Used by docker-compose / k8s --------------------------------------------
NODE_ENV=production
# Passed to the container; the log generator does not read these yet
# (SIEM output is configured under `output.http` in the YAML config)
LOG_LEVEL=info
SIEM_HTTP_URL=https://your-siem.example.com/api/logs
SIEM_API_TOKEN=your-siem-api-token-here

# docker-compose.production.yml: Grafana admin password
GRAFANA_PASSWORD=change-me

# docker-compose.yml: Wazuh / Elasticsearch credentials
WAZUH_ADMIN_USER=admin
WAZUH_ADMIN_PASSWORD=your-secure-wazuh-password
ELASTIC_PASSWORD=your-secure-elastic-password
